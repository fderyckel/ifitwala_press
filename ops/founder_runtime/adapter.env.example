# Control-plane host only. If Ifitwala_Press runs on another machine, set this there instead of on the founder VM.
IFITWALA_PRESS_FOUNDER_RUNTIME_ADAPTER=/Users/francois.de/Documents/ifitwala_press/ops/founder_runtime/adapter.py
IFITWALA_PRESS_FOUNDER_RUNTIME_TIMEOUT=1800

IFITWALA_FOUNDER_RUNTIME_ROOT=/srv/ifitwala-founder-runtime
# Build from ops/founder_runtime/image/build.env.example and pin the published tag here.
IFITWALA_FOUNDER_RUNTIME_IMAGE=ghcr.io/fderyckel/ifitwala-founder-runtime:2026-03-27-libmagic

IFITWALA_FOUNDER_RUNTIME_DB_HOST=127.0.0.1
IFITWALA_FOUNDER_RUNTIME_DB_PORT=3306
IFITWALA_FOUNDER_RUNTIME_DB_ROOT_USER=root
IFITWALA_FOUNDER_RUNTIME_DB_ROOT_PASSWORD=change-me
IFITWALA_FOUNDER_RUNTIME_ADMIN_PASSWORD=change-me

# Replace these with the real object-storage contract before first provision.
IFITWALA_FOUNDER_RUNTIME_S3_ENDPOINT=change-me
IFITWALA_FOUNDER_RUNTIME_S3_REGION=change-me
IFITWALA_FOUNDER_RUNTIME_S3_ACCESS_KEY=change-me
IFITWALA_FOUNDER_RUNTIME_S3_SECRET_KEY=change-me
IFITWALA_FOUNDER_RUNTIME_S3_FILES_BUCKET=change-me-files-bucket
IFITWALA_FOUNDER_RUNTIME_S3_BACKUPS_BUCKET=change-me-backups-bucket

# `*.ifitwala.com` is the locked tenant hostname space. Replace the zone and public IP with the real GCP values.
IFITWALA_FOUNDER_RUNTIME_DOMAIN_SUFFIX=ifitwala.com
IFITWALA_FOUNDER_RUNTIME_DNS_ZONE=change-me
IFITWALA_FOUNDER_RUNTIME_DNS_TARGET_IP=change-me
IFITWALA_FOUNDER_RUNTIME_DNS_TTL=300
IFITWALA_FOUNDER_RUNTIME_GCLOUD_PROJECT=ifitwala-production
IFITWALA_FOUNDER_RUNTIME_EDGE_PROXY_MODE=shared_nginx_proxy
IFITWALA_FOUNDER_RUNTIME_EDGE_PROXY_ROOT=/srv/ifitwala-founder-runtime/edge-proxy
IFITWALA_FOUNDER_RUNTIME_HTTP_PORT_BASE=18080

IFITWALA_FOUNDER_RUNTIME_EXECUTE=0
