# Control-plane host only. If Ifitwala_Press runs elsewhere, set these there instead of on the runtime VM.
IFITWALA_PRESS_SHARED_DEMO_BENCH_ADAPTER=/Users/francois.de/Documents/ifitwala_press/ops/shared_demo_bench/adapter.py
IFITWALA_PRESS_SHARED_DEMO_BENCH_TIMEOUT=1800

IFITWALA_SHARED_DEMO_BENCH_ROOT=/srv/ifitwala-shared-demo-bench
